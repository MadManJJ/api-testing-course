meta {
  name: Get missing order
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orders/ORD-doesnotexist
  body: none
  auth: none
}

script:post-response {
  test("returns 404 for a missing order", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.equal("Order not found");
  });
}
