meta {
  name: Reject unknown item
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "itemId": 999,
    "quantity": 1
  }
}

script:post-response {
  test("rejects items that do not exist", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.equal("Item not found");
  });
}
