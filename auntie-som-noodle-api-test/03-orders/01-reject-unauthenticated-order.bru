meta {
  name: Reject unauthenticated order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

script:post-response {
  test("requires a bearer token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("Unauthorized");
  });
}
