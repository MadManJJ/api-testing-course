meta {
  name: Reject order above stock
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "itemId": 2,
    "quantity": 2
  }
}

script:post-response {
  test("rejects a quantity greater than available stock", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
